# 复制为 .env 后仅在本机填写；.env 已被 Git 忽略。以下全部是占位值。
MYSQL_ROOT_PASSWORD=change-me-mysql-root

NACOS_DB_USER=nacos
NACOS_DB_PASSWORD=change-me-nacos-db
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-nacos
NACOS_NAMESPACE=docbase-dev
NACOS_GROUP=DOCBASE_GROUP
NACOS_AUTH_TOKEN=replace-with-base64-secret-at-least-32-bytes
NACOS_AUTH_IDENTITY_KEY=replace-with-server-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-server-identity-value

IAM_DB_USER=docbase_iam
IAM_DB_PASSWORD=change-me-iam-db
KNOWLEDGE_DB_USER=docbase_knowledge
KNOWLEDGE_DB_PASSWORD=change-me-knowledge-db
INGEST_DB_USER=docbase_ingest
INGEST_DB_PASSWORD=change-me-ingest-db
CHAT_DB_USER=docbase_chat
CHAT_DB_PASSWORD=change-me-chat-db
RAG_DB_USER=docbase_rag
RAG_DB_PASSWORD=change-me-rag-db

REDIS_ADMIN_PASSWORD=change-me-redis-admin
IAM_REDIS_PASSWORD=change-me-iam-redis
GATEWAY_REDIS_PASSWORD=change-me-gateway-redis
CHAT_REDIS_PASSWORD=change-me-chat-redis

RABBITMQ_USER=docbase
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=/docbase

MINIO_ROOT_USER=docbase-minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_APP_USER=docbase-app
MINIO_APP_PASSWORD=change-me-minio-app
MINIO_BUCKET=docbase-documents

# 不要从旧项目复制真实 Key 到仓库。模型名称继续沿用旧项目当前值。
DEEPSEEK_API_KEY=replace-with-local-secret
DEEPSEEK_MODEL=keep-existing-deepseek-model
RAG_INTERNAL_API_KEY=replace-with-local-internal-secret

# 后续 RAG 迁移时指向本机已有缓存；不要在本阶段下载新模型。
HF_HOME=replace-with-existing-huggingface-cache-path
